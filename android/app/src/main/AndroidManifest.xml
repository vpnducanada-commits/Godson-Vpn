<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Service de premier plan du tunnel VPN (type specialUse : cas reconnu pour les VPN,
         cf. docs/01_PHASE1_ARCHITECTURE.md §3) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications d'état réelles (demandée au runtime sur Android 13+, au moment utile) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GodsonApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GodsonVPN">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GodsonVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tunnel VPN. La permission BIND_VPN_SERVICE est accordée par le système seul ;
             le consentement utilisateur est obtenu via VpnService.prepare(). -->
        <service
            android:name=".vpn.GodsonVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Établissement et maintien du tunnel VPN WireGuard demandé par l'utilisateur" />
        </service>
    </application>
</manifest>
